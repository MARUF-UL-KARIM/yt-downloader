# Server runtime defaults
PORT=3000
NODE_ENV=development

# Optional: clean-IP proxy for yt-dlp (leave blank if not using)
YTDLP_PROXY=

# YouTube cookies (Netscape format). On Render add a Secret File named cookies.txt
# (it appears at /etc/secrets/cookies.txt and is picked up automatically for YouTube links only).
# YT_COOKIES_FILE=/etc/secrets/cookies.txt

# Optional advanced overrides (supported by server/config.ts; not required for normal deployment):
# TEMP_DIR=/tmp/clipfetch_jobs
# MAX_FILE_SIZE_MB=500
# MAX_DURATION_SEC=3600
# MAX_CONCURRENT_JOBS=4
# JOB_TIMEOUT_SEC=600
# AUTO_CLEANUP_MINUTES=15
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_B64=
# YTDLP_BIN=
# FFMPEG_BIN=
# FFPROBE_BIN=
# NODE_BIN=
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=false
# CORS_ORIGINS=*
